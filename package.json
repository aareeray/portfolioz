{
  "name": "portfolioz",
  "version": "1.0.0",
  "private": true,
  "description": "High-fidelity recreation of an award-winning minimal creative portfolio experience. Zero-runtime-dependency full-stack TypeScript app on Node built-ins (node:http + node:sqlite).",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --experimental-sqlite --watch src/server/index.ts",
    "start": "NODE_ENV=production node --experimental-strip-types --experimental-sqlite src/server/index.ts",
    "build": "node --experimental-strip-types scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"public/js/**/*.mjs\"",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"public/js/**/*.mjs\"",
    "test": "node --experimental-strip-types --experimental-sqlite --test tests/**/*.test.ts",
    "db:generate": "echo \"Schema is defined in src/data/migrations.ts (applied on boot and via db:migrate).\"",
    "db:migrate": "node --experimental-strip-types --experimental-sqlite scripts/migrate.ts",
    "db:seed": "node --experimental-strip-types --experimental-sqlite scripts/seed.ts"
  },
  "keywords": [
    "portfolio",
    "creative-portfolio",
    "typescript",
    "node",
    "sqlite",
    "ssr"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
