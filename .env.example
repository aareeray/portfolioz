# ─────────────────────────────────────────────────────────────────────────────
# portfolioz environment variables
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Public origin used for canonical URLs, sitemap, and OG tags.
SITE_URL=http://localhost:3000

# Database
# Path to the SQLite database file (created automatically). Relative to project root.
DATABASE_PATH=.data/portfolioz.sqlite
# For the production Prisma/PostgreSQL migration path (see docs/architecture.md):
# DATABASE_URL=postgresql://user:password@host:5432/portfolioz

# Security
# 32+ char random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
# Cookie is marked Secure automatically when NODE_ENV=production.

# Admin bootstrap (used only by `npm run db:seed` to create the first admin user)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# Contact form rate limiting (token bucket)
CONTACT_RATE_LIMIT=5          # max submissions
CONTACT_RATE_WINDOW_MS=600000 # per window (default 10 minutes)

# Email delivery (EmailService abstraction). provider: console | resend
EMAIL_PROVIDER=console
EMAIL_FROM=hello@example.com
EMAIL_TO=hello@example.com
# Only required when EMAIL_PROVIDER=resend (network access needed at runtime):
RESEND_API_KEY=

# Analytics abstraction. provider: none | log
ANALYTICS_PROVIDER=log
